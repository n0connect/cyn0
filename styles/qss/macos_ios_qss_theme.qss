/* ----------------------------------------
   macOS/iOS Inspired Dark Theme for Qt Applications
   Compatible with Qt QSS - No unsupported CSS properties
---------------------------------------- */

/* ----------------------------------------
   Base Style for All Widgets
---------------------------------------- */
QWidget {
    background-color: #1C1C1E;
    color: #FFFFFF;
    font-family: "SF-Pro-Rounded-Black";
    font-size: 14px;
    border-radius: 10px;
    border: 1px solid #2C2C2E;
    padding: 4px;
}

/* ----------------------------------------
   Main Window & Dialogs
---------------------------------------- */
QMainWindow, QDialog {
    background-color: #000000;
    border-radius: 12px;
    border: 1px solid #1C1C1E;
}

/* ----------------------------------------
   QLabel
---------------------------------------- */
QLabel {
    color: #FFFFFF;
    font-weight: 400;
    font-size: 14px;
    padding: 4px 8px;
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QLabel[class="title"] {
    font-size: 17px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel[class="subtitle"] {
    font-size: 13px;
    font-weight: 400;
    color: #8E8E93;
}

/* ----------------------------------------
   QPushButton - macOS/iOS Style
---------------------------------------- */
QPushButton {
    background-color: #007AFF;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 12px 24px;
    border: none;
    font-weight: 600;
    font-size: 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #0056CC;
}

QPushButton:pressed {
    background-color: #004999;
}

QPushButton:disabled {
    background-color: #1C1C1E;
    color: #48484A;
}

/* Secondary Button Style */
QPushButton[class="secondary"] {
    background-color: #2C2C2E;
    color: #007AFF;
    border: 1px solid #007AFF;
}

QPushButton[class="secondary"]:hover {
    background-color: #007AFF;
    color: #FFFFFF;
}

/* Destructive Button Style */
QPushButton[class="destructive"] {
    background-color: #FF3B30;
    color: #FFFFFF;
}

QPushButton[class="destructive"]:hover {
    background-color: #D70015;
}

/* ----------------------------------------
   QLineEdit & QTextEdit - iOS Style
---------------------------------------- */
QLineEdit, QTextEdit {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 10px;
    padding: 12px 16px;
    color: #FFFFFF;
    font-size: 14px;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #007AFF;
    background-color: #1C1C1E;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #0A0A0A;
    color: #48484A;
    border-color: #2C2C2E;
}

QLineEdit::placeholder {
    color: #8E8E93;
}

/* ----------------------------------------
   QTextBrowser - macOS/iOS Reading Style
---------------------------------------- */
QTextBrowser {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 12px;
    padding: 16px 20px;
    color: #FFFFFF;
    font-size: 14px;
    line-height: 1.4;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
}

QTextBrowser:focus {
    border-color: #007AFF;
}

/* ----------------------------------------
   QCheckBox & QRadioButton - iOS Style
---------------------------------------- */
QCheckBox, QRadioButton {
    spacing: 12px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 400;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #3A3A3C;
    background-color: transparent;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #007AFF;
}

QCheckBox::indicator:checked {
    background-color: #007AFF;
    border-color: #007AFF;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iOSIgdmlld0JveD0iMCAwIDEyIDkiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0xIDQuNUw0LjUgOEwxMSAxIiBzdHJva2U9IndoaXRlIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPgo8L3N2Zz4K);
}

QRadioButton::indicator {
    border-radius: 10px;
}

QRadioButton::indicator:checked {
    background-color: #007AFF;
    border-color: #007AFF;
}

/* ----------------------------------------
   QComboBox - macOS/iOS Style
---------------------------------------- */
QComboBox {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 10px;
    padding: 8px 16px;
    color: #FFFFFF;
    min-height: 32px;
    font-size: 14px;
}

QComboBox:hover {
    border-color: #007AFF;
}

QComboBox:focus {
    border-color: #007AFF;
    background-color: #1C1C1E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border-left: 1px solid #3A3A3C;
    border-radius: 0 10px 10px 0;
    background-color: transparent;
}

QComboBox::down-arrow {
    width: 12px;
    height: 8px;
    background-color: #8E8E93;
    border-radius: 2px;
}

QComboBox QAbstractItemView {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 10px;
    padding: 4px;
    color: #FFFFFF;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    padding: 8px 16px;
    border-radius: 6px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2C2C2E;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #007AFF;
}

/* ----------------------------------------
   QListWidget & QTableWidget - iOS Style
---------------------------------------- */
QListWidget, QTableWidget {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 12px;
    padding: 8px;
    alternate-background-color: #0A0A0A;
}

QListWidget::item, QTableWidget::item {
    padding: 12px 16px;
    border-radius: 8px;
    color: #FFFFFF;
    border: none;
    margin: 2px 0;
}

QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #2C2C2E;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}

QListWidget::item:alternate {
    background-color: #0A0A0A;
}

/* ----------------------------------------
   QTreeWidget - macOS Sidebar Style
---------------------------------------- */
QTreeWidget {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 10px;
    padding: 4px;
    color: #FFFFFF;
    alternate-background-color: #0A0A0A;
    show-decoration-selected: 1;
}

QTreeWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 1px 0;
}

QTreeWidget::item:hover {
    background-color: #2C2C2E;
}

QTreeWidget::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}

QTreeWidget::branch:closed:has-children {
    background-color: #8E8E93;
    border-radius: 2px;
}

QTreeWidget::branch:open:has-children {
    background-color: #8E8E93;
    border-radius: 2px;
}

/* ----------------------------------------
   QSlider - iOS Style
---------------------------------------- */
QSlider::groove:horizontal {
    height: 4px;
    background: #3A3A3C;
    border-radius: 2px;
    margin: 8px 0;
}

QSlider::groove:vertical {
    width: 4px;
    background: #3A3A3C;
    border-radius: 2px;
    margin: 0 8px;
}

QSlider::handle:horizontal, QSlider::handle:vertical {
    background: #FFFFFF;
    border: 3px solid #007AFF;
    border-radius: 12px;
    width: 20px;
    height: 20px;
}

QSlider::handle:horizontal {
    margin: -8px 0;
}

QSlider::handle:vertical {
    margin: 0 -8px;
}

QSlider::handle:hover {
    border-color: #0056CC;
}

QSlider::handle:pressed {
    border-color: #004999;
}

QSlider::sub-page:horizontal {
    background: #007AFF;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #007AFF;
    border-radius: 2px;
}

/* ----------------------------------------
   QProgressBar - iOS Style
---------------------------------------- */
QProgressBar {
    border-radius: 8px;
    background-color: #3A3A3C;
    border: none;
    height: 6px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 500;
    font-size: 12px;
}

QProgressBar::chunk {
    background-color: #007AFF;
    border-radius: 8px;
}

/* ----------------------------------------
   QDateEdit, QTimeEdit, QDateTimeEdit
---------------------------------------- */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 10px;
    padding: 8px 16px;
    color: #FFFFFF;
    font-size: 14px;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: #007AFF;
}

QDateEdit::drop-down, QTimeEdit::drop-down, QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #3A3A3C;
    border-radius: 0 10px 10px 0;
    background-color: transparent;
}

/* ----------------------------------------
   QSpinBox & QDoubleSpinBox
---------------------------------------- */
QSpinBox, QDoubleSpinBox {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 10px;
    padding: 8px 16px;
    color: #FFFFFF;
    font-size: 14px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #007AFF;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #3A3A3C;
    border-radius: 0 10px 0 0;
    background-color: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #3A3A3C;
    border-radius: 0 0 10px 0;
    background-color: transparent;
}

/* ----------------------------------------
   QGroupBox - macOS/iOS Card Style
---------------------------------------- */
QGroupBox {
    border: 1px solid #2C2C2E;
    border-radius: 12px;
    margin-top: 16px;
    padding: 16px 20px 20px 20px;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 15px;
    background-color: #1C1C1E;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: #000000;
    border-radius: 6px;
    color: #FFFFFF;
}

/* ----------------------------------------
   QTabWidget - macOS/iOS Style
---------------------------------------- */
QTabWidget::pane {
    border: 1px solid #2C2C2E;
    border-radius: 12px;
    background-color: #1C1C1E;
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: center;
}

QTabBar::tab {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    margin-right: 4px;
    color: #8E8E93;
    font-weight: 500;
    font-size: 14px;
    min-width: 80px;
}

QTabBar::tab:selected {
    background: #007AFF;
    color: #FFFFFF;
}

QTabBar::tab:hover:!selected {
    background: #2C2C2E;
    color: #FFFFFF;
}

/* ----------------------------------------
   QScrollArea & Scrollbars - macOS Style
---------------------------------------- */
QScrollArea {
    background-color: transparent;
    border-radius: 10px;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #48484A;
    border-radius: 4px;
    min-height: 20px;
    min-width: 20px;
}

QScrollBar::handle:hover {
    background: #5A5A5C;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ----------------------------------------
   QMenuBar, QMenu, QToolBar, QStatusBar
---------------------------------------- */
QMenuBar {
    background-color: #1C1C1E;
    border-bottom: 1px solid #2C2C2E;
    padding: 4px 8px;
    color: #FFFFFF;
    font-weight: 500;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}

QMenu {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 10px;
    padding: 4px;
    color: #FFFFFF;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 6px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #2C2C2E;
    margin: 4px 8px;
}

QToolBar {
    background-color: #1C1C1E;
    border: none;
    padding: 4px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    color: #FFFFFF;
}

QToolButton:hover {
    background-color: #2C2C2E;
}

QToolButton:pressed {
    background-color: #007AFF;
}

QStatusBar {
    background-color: #1C1C1E;
    border-top: 1px solid #2C2C2E;
    padding: 4px 12px;
    color: #8E8E93;
    font-weight: 400;
    font-size: 12px;
}

/* ----------------------------------------
   Additional UI Elements
---------------------------------------- */

/* Tooltips - macOS/iOS Style */
QToolTip {
    background-color: #2C2C2E;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    border: 1px solid #3A3A3C;
}

/* Dock Widget */
QDockWidget {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 10px;
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(float.png);
}

QDockWidget::title {
    background-color: #2C2C2E;
    color: #FFFFFF;
    padding: 8px;
    border-radius: 10px 10px 0 0;
    font-weight: 600;
}

/* Splitter */
QSplitter::handle {
    background-color: #2C2C2E;
    border-radius: 2px;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #007AFF;
}

/* Frame */
QFrame {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 10px;
}

QFrame[frameShape="1"] { /* Box */
    border: 1px solid #2C2C2E;
}

QFrame[frameShape="2"] { /* Panel */
    border: 1px solid #2C2C2E;
    background-color: #0A0A0A;
}

/* Header View */
QHeaderView::section {
    background-color: #2C2C2E;
    color: #FFFFFF;
    padding: 8px 12px;
    border: none;
    border-right: 1px solid #3A3A3C;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #3A3A3C;
}

QHeaderView::section:pressed {
    background-color: #007AFF;
}

/* Dial */
QDial {
    background-color: #1C1C1E;
    border: 2px solid #3A3A3C;
    border-radius: 50px;
}

QDial::handle {
    background-color: #007AFF;
    border-radius: 6px;
    width: 12px;
    height: 12px;
}

/* LCD Number */
QLCDNumber {
    background-color: #000000;
    color: #007AFF;
    border: 1px solid #2C2C2E;
    border-radius: 8px;
}

/* Calendar Widget */
QCalendarWidget {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 12px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background-color: #2C2C2E;
    border-radius: 6px;
}

QCalendarWidget QMenu {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
}

QCalendarWidget QSpinBox {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    color: #FFFFFF;
}

QCalendarWidget QAbstractItemView {
    background-color: #1C1C1E;
    color: #FFFFFF;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
}

/* Text Formatting */
QTextEdit[class="code"] {
    font-family: "SF-Pro-Rounded-Black";
    background-color: #0A0A0A;
    border: 1px solid #2C2C2E;
    border-radius: 8px;
    padding: 16px;
    color: #FFFFFF;
    font-size: 13px;
    line-height: 1.4;
}

/* Size Grip */
QSizeGrip {
    background-color: transparent;
    width: 16px;
    height: 16px;
}