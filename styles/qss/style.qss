/* Genel Temel Stil */
QWidget {
    background-color: #1E1E1E;
    color: #F0F0F0;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 14px;
    border: none;
}

/* Ana Pencereye Gölgelendirme efekti (yalnızca özel pencere sınıfında geçerli olabilir) */
QMainWindow {
    border-radius: 16px;
    background-color: #1E1E1E;
}

/* Arama Kutusu */
QLineEdit {
    background-color: #2A2A2A;
    border: 1px solid #3C3C3C;
    padding: 8px 12px;
    border-radius: 12px;
    color: #FFFFFF;
    selection-background-color: #4A90E2;
}

/* Liste Kutusu */
QListWidget {
    background-color: #2B2B2B;
    border: 1px solid #3C3C3C;
    border-radius: 12px;
    padding: 4px;
}

/* Liste Öğeleri */
QListWidget::item {
    padding: 10px 12px;
    border-radius: 8px;
    color: #DCDCDC;
}

/* Hover ve Seçim Efektleri */
QListWidget::item:hover {
    background-color: #3A3A3A;
    color: #FFFFFF;
}

QListWidget::item:selected {
    background-color: #4A90E2;
    color: #FFFFFF;
}

/* Butonlar */
QPushButton {
    background-color: #3A3A3A;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 8px 16px;
    border: 1px solid #555555;
}

QPushButton:hover {
    background-color: #4A4A4A;
}

QPushButton:pressed {
    background-color: #2A2A2A;
}

/* Scrollbar Stili */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 8px;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle {
    background: #4A90E2;
    border-radius: 4px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    border: none;
}
