{
    "waes": {
        "desc": "Web Application Enumeration Scanner - comprehensive web application reconnaissance",
        "category": "Web Application Scanning",
        "usage": [
            "waes -u http://target.com",
            "waes -u http://target.com -w /usr/share/wordlists/dirb/common.txt",
            "waes -u http://target.com --full-scan"
        ],
        "features": [
            "Directory enumeration",
            "Subdomain discovery",
            "Technology detection",
            "Vulnerability scanning",
            "SSL/TLS analysis"
        ],
        "flags": {
            "-u": "Target URL",
            "-w": "Wordlist file",
            "--threads": "Number of threads",
            "--timeout": "Request timeout",
            "--full-scan": "Comprehensive scanning",
            "--output": "Output file format"
        },
        "examples": [
            {
                "desc": "Basic web enumeration",
                "command": "waes -u http://target.com --threads 20"
            }
        ],
        "notes": [
            "Comprehensive web application analysis",
            "Multiple scanning modules"
        ],
        "security_risk": "Medium - Active scanning",
        "platform": ["Linux", "macOS"],
        "required_permissions": "Network access"
    },
    "rapiscan": {
        "desc": "Rapid API security scanner for REST API vulnerability assessment",
        "category": "API Security Testing",
        "usage": [
            "rapiscan -u http://api.target.com",
            "rapiscan --swagger http://api.target.com/swagger.json",
            "rapiscan -u http://api.target.com --auth-token YOUR_TOKEN"
        ],
        "vulnerability_checks": [
            "Authentication bypass",
            "Authorization flaws",
            "Input validation",
            "Rate limiting",
            "Information disclosure",
            "OWASP API Top 10"
        ],
        "flags": {
            "-u": "API base URL",
            "--swagger": "Swagger/OpenAPI specification",
            "--auth-token": "Authentication token",
            "--rate-limit": "Requests per second",
            "--output": "Output format (json, xml, html)"
        },
        "examples": [
            {
                "desc": "Basic API scan",
                "command": "rapiscan -u https://api.example.com/v1"
            },
            {
                "desc": "Swagger-based testing",
                "command": "rapiscan --swagger https://api.example.com/swagger.json"
            }
        ],
        "notes": [
            "OWASP API Top 10 focused",
            "Swagger/OpenAPI integration"
        ],
        "security_risk": "Medium - API vulnerability testing",
        "platform": ["Linux", "Windows", "macOS"],
        "required_permissions": "Network access"
    },
    "wapiti": {
        "desc": "Web application vulnerability scanner - black-box security auditing",
        "category": "Web Vulnerability Scanner",
        "usage": [
            "wapiti -u http://target.com",
            "wapiti -u http://target.com -m all",
            "wapiti -u http://target.com --scope domain"
        ],
        "flags": {
            "-u": "Target URL",
            "-m": "Modules to use (all, sql, xss, file, etc.)",
            "--scope": "Scanning scope (page, folder, domain, punk)",
            "-v": "Verbosity level",
            "-f": "Output format (html, json, txt, xml)",
            "-o": "Output file",
            "--color": "Colorize output",
            "--time-limit": "Maximum scan time",
            "--max-depth": "Maximum link depth",
            "--max-files-per-dir": "Files per directory limit",
            "--max-scan-time": "Maximum time per URL",
            "--timeout": "Request timeout",
            "--verify-ssl": "Verify SSL certificates",
