            "--auth-type": "Authentication type",
            "--auth-user": "Authentication username",
            "--auth-password": "Authentication password",
            "--cookie": "Cookie string"
        },
        "vulnerability_modules": {
            "sql": "SQL injection detection",
            "xss": "Cross-site scripting",
            "file": "File inclusion vulnerabilities",
            "exec": "Command execution",
            "crlf": "CRLF injection",
            "xxe": "XML external entity",
            "ssrf": "Server-side request forgery",
            "redirect": "Open redirect",
            "htaccess": ".htaccess bypass",
            "backup": "Backup file detection",
            "shellshock": "Shellshock vulnerability",
            "nikto": "Nikto-based checks"
        },
        "examples": [
            {
                "desc": "Comprehensive scan",
                "command": "wapiti -u http://target.com -m all --scope domain -f html -o report.html"
            },
            {
                "desc": "Specific vulnerability testing",
                "command": "wapiti -u http://target.com -m sql,xss,file --max-depth 3"
            },
            {
                "desc": "Authenticated scanning",
                "command": "wapiti -u http://target.com --cookie 'PHPSESSID=abc123' -m all"
            }
        ],
        "output_formats": ["HTML", "JSON", "TXT", "XML"],
        "notes": [
            "Python dilinde yazılmış",
            "Modüler yapı",
            "Comprehensive vulnerability detection"
        ],
        "security_risk": "High - Active vulnerability testing",
        "platform": ["Linux", "Windows", "macOS"],
        "required_permissions": "Network access"
    },
