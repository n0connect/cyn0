        "$ne - Not equal",
        "$gt - Greater than",
        "$gte - Greater than or equal",
        "$lt - Less than",
        "$lte - Less than or equal",
        "$in - In array",
        "$nin - Not in array"
      ],
      "logical": [
        "$and",
        "$or",
        "$not",
        "$nor"
      ],
      "element": [
        "$exists",
        "$type"
      ],
      "evaluation": [
        "$regex",
        "$where",
        "$expr"
      ]
