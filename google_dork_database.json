{
    "display_name": "Google Dork Database",
    "description": "Google dorking techniques and search operators for OSINT and security testing",

    "Basic Operators": {
        "desc": "Essential Google search operators",
        "commands": [
            {
                "desc": "Search exact phrase",
                "command": "\"exact phrase here\"",
                "example": "\"admin login\" - finds exact match"
            },
            {
                "desc": "Search within specific site",
                "command": "site:domain.com keyword",
                "example": "site:example.com admin - searches only example.com"
            },
            {
                "desc": "Search specific file type",
                "command": "filetype:ext keyword",
                "example": "filetype:pdf confidential - finds PDF files"
            },
            {
                "desc": "Search in URL",
                "command": "inurl:keyword",
                "example": "inurl:admin - finds admin in URL"
            },
            {
                "desc": "Search in page title",
                "command": "intitle:keyword",
                "example": "intitle:\"index of\" - finds directory listings"
            },
            {
                "desc": "Search in page text",
                "command": "intext:keyword",
                "example": "intext:password - finds password in page content"
            },
            {
                "desc": "Find related websites",
                "command": "related:domain.com",
                "example": "related:github.com - finds similar sites"
            },
            {
                "desc": "View cached version",
                "command": "cache:domain.com",
                "example": "cache:example.com - shows Google's cached page"
            }
        ]
    },

    "Exposed Files & Documents": {
        "desc": "Finding sensitive documents and configuration files",
        "commands": [
            {
                "desc": "Find exposed SQL dumps",
                "command": "filetype:sql intext:password",
                "example": "site:target.com filetype:sql \"INSERT INTO\" password"
            },
            {
                "desc": "Find database backup files",
                "command": "ext:sql | ext:bak | ext:backup intext:\"database\"",
                "example": "site:example.com (ext:sql | ext:bak) intext:password"
            },
            {
                "desc": "Find exposed environment files",
                "command": "inurl:.env | inurl:env.txt | inurl:config.env",
                "example": "site:target.com inurl:.env DB_PASSWORD"
            },
            {
                "desc": "Find exposed Git repositories",
                "command": "inurl:/.git intitle:index.of",
                "example": "site:company.com inurl:/.git intitle:\"index of\""
            },
            {
                "desc": "Find AWS credentials",
                "command": "filetype:env \"AWS_ACCESS_KEY_ID\"",
                "example": "site:target.com filetype:env AWS_SECRET"
            },
            {
                "desc": "Find SSH private keys",
                "command": "intitle:\"index of\" id_rsa -id_rsa.pub",
                "example": "site:company.com intitle:\"index of\" id_rsa"
            },
            {
                "desc": "Find config files",
                "command": "ext:conf | ext:config | ext:cfg intext:password",
                "example": "site:target.com ext:conf password"
            },
            {
                "desc": "Find log files with credentials",
                "command": "ext:log intext:password | intext:username",
                "example": "site:company.com ext:log \"password:\" | \"user:\""
            }
        ]
