    "Exclusion Operators": {
        "desc": "Refining searches by excluding unwanted results",
        "commands": [
            {
                "desc": "Exclude specific term",
                "command": "-keyword",
                "example": "site:company.com admin -www - excludes www subdomain"
            },
            {
                "desc": "Exclude file types",
                "command": "-filetype:pdf",
                "example": "site:target.com documents -filetype:pdf - exclude PDFs"
            },
            {
                "desc": "Exclude multiple terms",
                "command": "-word1 -word2",
                "example": "site:company.com -blog -news - exclude blog and news"
            },
            {
                "desc": "Exclude subdomains",
                "command": "site:*.target.com -www -mail",
                "example": "site:*.example.com -www -ftp -mail"
            }
        ]
    },

    "Google Dork Cheat Sheet": {
        "desc": "Quick reference for common operators",
        "commands": [
            {
                "desc": "Combine multiple operators",
                "command": "site: + inurl: + filetype: + intext:",
                "example": "site:target.com inurl:admin filetype:php intext:login"
            },
            {
                "desc": "Use OR operator",
                "command": "keyword1 | keyword2",
                "example": "(admin | administrator | root) login"
            },
            {
                "desc": "Use wildcard",
                "command": "keyword * keyword",
                "example": "admin * password - matches any words between"
            },
            {
                "desc": "Number ranges",
                "command": "keyword 2020..2024",
                "example": "site:company.com report 2020..2024"
            },
            {
                "desc": "Search within URL path",
                "command": "allinurl:keyword1 keyword2",
                "example": "allinurl:admin panel login"
            },
            {
                "desc": "Search all text in page",
                "command": "allintext:keyword1 keyword2",
                "example": "allintext:username password database"
            },
            {
                "desc": "Search all words in title",
                "command": "allintitle:keyword1 keyword2",
                "example": "allintitle:index of backup"
            }
        ]
    },

